/bun.lock                                   @ismaelkouda @soumailakouda
/nx.json                                    @ismaelkouda @soumailakouda
/tsconfig.base.json                         @ismaelkouda @soumailakouda
/eslint.config.mjs                          @ismaelkouda @soumailakouda
/commitlint.config.mjs                      @ismaelkouda @soumailakouda
/knip.json                                  @ismaelkouda @soumailakouda
/.husky/                                    @ismaelkouda @soumailakouda
/.github/                                   @ismaelkouda @soumailakouda
/tools/                                     @ismaelkouda @soumailakouda
/tools/check-*.mjs                          @ismaelkouda @soumailakouda
/tools/vitest-lib.config.ts                 @ismaelkouda @soumailakouda

